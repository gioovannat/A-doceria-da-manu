# ========================================================================
# VARIÁVEIS DE AMBIENTE - A DOCERIA DA MANU
# ========================================================================

# Supabase Database & Auth (Compatível com Vite e Next.js/Vercel)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anonima-publica"

NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anonima-publica"

# Chave de Serviço Supabase (NUNCA expor no frontend; apenas scripts/backend)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Rota Base Administrativa (Personalizável sem alterar código)
# Exemplo: /atelier-gestao, /central-manu, /studio-gestao
VITE_ADMIN_BASE_PATH="/atelier-gestao"
ADMIN_BASE_PATH="/atelier-gestao"

# Domínio do Site
NEXT_PUBLIC_SITE_URL="https://www.adoceriadamanu.com.br"
VITE_SITE_URL="https://www.adoceriadamanu.com.br"

# Google Gemini API (Opcional caso utilize IA no backend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
